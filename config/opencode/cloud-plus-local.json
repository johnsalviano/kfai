{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "9Router",
      "options": {
        "baseURL": "http://localhost:20128/v1",
        "apiKey": "{env:KFAI_NINEROUTER_KEY}"
      },
      "models": {
        "combo-cloud-plus-local": {
          "name": "KFAI - Cloud + Local (nuvem 1a, local fallback)",
          "limit": { "context": 200000, "output": 65536 }
        },
        "oc/deepseek-v4-flash-free": {
          "name": "Cloud Free: DeepSeek V4 Flash",
          "limit": { "context": 128000, "output": 8192 }
        },
        "oc/mimo-v2.5-free": {
          "name": "Cloud Free: Mimo V2.5",
          "limit": { "context": 128000, "output": 8192 }
        },
        "oc/ling-3.0-flash-free": {
          "name": "Cloud Free: Ling 3.0 Flash",
          "limit": { "context": 128000, "output": 8192 }
        },
        "oc/nemotron-3-ultra-free": {
          "name": "Cloud Free: Nemotron 3 Ultra",
          "limit": { "context": 128000, "output": 8192 }
        },
        "nvidia/z-ai/glm-5.2": {
          "name": "Cloud NVIDIA: GLM 5.2 (gratuito)",
          "limit": { "context": 131072, "output": 32768 }
        },
        "nvidia/deepseek-ai/deepseek-v4-flash": {
          "name": "Cloud NVIDIA: DeepSeek V4 Flash",
          "limit": { "context": 128000, "output": 8192 }
        },
        "nvidia/minimaxai/minimax-m3": {
          "name": "Cloud NVIDIA: MiniMax M3",
          "limit": { "context": 131072, "output": 32768 }
        }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "apiKey": "ollama"
      },
      "models": {}
    }
  },
  "model": "9router/combo-cloud-plus-local"
}