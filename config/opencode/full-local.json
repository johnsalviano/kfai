{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "apiKey": "ollama"
      },
      "models": {
        "KFAI_LOCAL_MODEL": {
          "name": "KFAI Local (num_ctx 64k)",
          "tools": true,
          "limit": { "context": 65536, "output": 8192 }
        }
      }
    }
  },
  "model": "ollama/KFAI_LOCAL_MODEL"
}
