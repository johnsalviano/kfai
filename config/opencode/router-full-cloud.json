{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "kfai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "KFAI Router",
      "options": {
        "baseURL": "http://localhost:20129/v1",
        "apiKey": "{env:KFAI_ROUTER_KEY}"
      },
      "models": {
        "full-cloud": {
          "name": "KFAI - Full Cloud (nuvem gratuita)",
          "limit": { "context": 200000, "output": 65536 }
        },
        "full-local": {
          "name": "KFAI - Full Local (somente Ollama)",
          "limit": { "context": 200000, "output": 65536 }
        },
        "cloud-plus-local": {
          "name": "KFAI - Cloud + Local (nuvem 1a, local fallback)",
          "limit": { "context": 200000, "output": 65536 }
        }
      }
    }
  },
  "model": "kfai/full-cloud"
}
