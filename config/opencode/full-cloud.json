{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "9Router",
      "options": {
        "baseURL": "http://localhost:20128/v1",
        "apiKey": "9router"
      },
      "models": {
        "todas-free": {
          "name": "KFAI - Full Cloud (todos os gratis do 9Router)",
          "limit": { "context": 200000, "output": 65536 }
        },
        "gemini/gemini-3-flash-preview": {
          "name": "Cloud Free: Gemini 3 Flash",
          "limit": { "context": 1048576, "output": 65536 }
        },
        "nvidia/z-ai/glm-5.2": {
          "name": "Cloud NVIDIA: GLM 5.2 (gratuito)",
          "limit": { "context": 131072, "output": 32768 }
        },
        "nvidia/deepseek-ai/deepseek-v4-flash": {
          "name": "Cloud NVIDIA: DeepSeek V4 Flash",
          "limit": { "context": 128000, "output": 8192 }
        },
        "nvidia/minimaxai/minimax-m3": {
          "name": "Cloud NVIDIA: MiniMax M3",
          "limit": { "context": 131072, "output": 32768 }
        },
        "ps/laguna-s-2.1": {
          "name": "Cloud Poolside: Laguna S 2.1",
          "limit": { "context": 128000, "output": 8192 }
        }
      }
    }
  },
  "model": "9router/todas-free"
}